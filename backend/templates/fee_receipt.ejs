<!DOCTYPE html>
<html>
<head>
    <style>
        body { font-family: 'Helvetica', 'Arial', sans-serif; color: #333; line-height: 1.6; }
        .container { border: 2px solid #eee; padding: 40px; max-width: 800px; margin: auto; }
        .header { text-align: center; border-bottom: 2px solid #4F46E5; padding-bottom: 20px; margin-bottom: 30px; }
        .school-name { font-size: 24px; font-weight: bold; color: #4F46E5; margin-bottom: 5px; }
        .receipt-title { font-size: 18px; font-weight: bold; text-transform: uppercase; letter-spacing: 2px; color: #666; }
        .info-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 40px; }
        .info-item { margin-bottom: 10px; }
        .info-label { font-weight: bold; font-size: 12px; color: #999; text-transform: uppercase; }
        .info-value { font-size: 16px; border-bottom: 1px solid #f0f0f0; }
        .payment-table { w-full; border-collapse: collapse; margin-bottom: 40px; }
        .payment-table th { background: #f9fafb; text-align: left; padding: 12px; font-size: 12px; text-transform: uppercase; border-bottom: 1px solid #eee; }
        .payment-table td { padding: 12px; border-bottom: 1px solid #f0f0f0; }
        .total-box { background: #4F46E5; color: white; padding: 20px; border-radius: 8px; text-align: right; }
        .total-label { font-size: 14px; opacity: 0.8; }
        .total-amount { font-size: 28px; font-weight: bold; }
        .footer { margin-top: 50px; text-align: center; font-size: 12px; color: #aaa; border-top: 1px solid #eee; padding-top: 20px; }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <div class="school-name"><%= institution_name %></div>
            <div class="receipt-title">Fee Payment Receipt</div>
        </div>

        <div class="info-grid">
            <div class="info-item">
                <div class="info-label">Receipt No</div>
                <div class="info-value">#<%= receipt_no %></div>
            </div>
            <div class="info-item">
                <div class="info-label">Date</div>
                <div class="info-value"><%= payment_date %></div>
            </div>
            <div class="info-item">
                <div class="info-label">Student Name</div>
                <div class="info-value"><%= student_name %></div>
            </div>
            <div class="info-item">
                <div class="info-label">Reg. No / Class</div>
                <div class="info-value"><%= admission_no %> | <%= class_name %></div>
            </div>
        </div>

        <table class="payment-table" style="width: 100%;">
            <thead>
                <tr>
                    <th>Description</th>
                    <th style="text-align: right;">Amount</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>Fee Payment for Invoice #<%= invoice_no %></td>
                    <td style="text-align: right;">₹<%= amount.toLocaleString() %></td>
                </tr>
            </tbody>
        </table>

        <div class="info-grid" style="margin-top: 20px;">
            <div class="info-item">
                <div class="info-label">Payment Mode</div>
                <div class="info-value" style="text-transform: uppercase;"><%= payment_mode %></div>
            </div>
            <% if (transaction_id) { %>
            <div class="info-item">
                <div class="info-label">Transaction ID</div>
                <div class="info-value"><%= transaction_id %></div>
            </div>
            <% } %>
        </div>

        <div class="total-box">
            <div class="total-label">Total Amount Paid</div>
            <div class="total-amount">₹<%= amount.toLocaleString() %></div>
        </div>

        <div class="footer">
            <p>This is a computer-generated receipt and does not require a physical signature.</p>
            <p>Thank you for your payment!</p>
        </div>
    </div>
</body>
</html>
