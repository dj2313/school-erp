<!DOCTYPE html>
<html>

<head>
    <style>
        body {
            font-family: 'Helvetica', 'Arial', sans-serif;
            color: #333;
            margin: 0;
            padding: 40px;
        }

        .report-card {
            border: 15px solid #4F46E5;
            padding: 40px;
            min-height: 1000px;
            position: relative;
        }

        .watermark {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%) rotate(-45deg);
            font-size: 100px;
            color: #f0f0f0;
            z-index: -1;
            white-space: nowrap;
            font-weight: bold;
        }

        .header {
            text-align: center;
            border-bottom: 2px solid #4F46E5;
            padding-bottom: 20px;
            margin-bottom: 30px;
        }

        .school-name {
            font-size: 32px;
            font-weight: bold;
            color: #4F46E5;
            margin-bottom: 5px;
        }

        .title {
            font-size: 20px;
            font-weight: bold;
            text-transform: uppercase;
            color: #666;
        }

        .student-info {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 40px;
        }

        .info-item {
            display: flex;
            border-bottom: 1px solid #eee;
            padding: 5px 0;
        }

        .info-label {
            font-weight: bold;
            width: 120px;
            color: #666;
            font-size: 14px;
        }

        .info-value {
            font-weight: bold;
            font-size: 14px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 40px;
        }

        th {
            background: #4F46E5;
            color: white;
            padding: 12px;
            font-size: 14px;
            border: 1px solid #4F46E5;
        }

        td {
            padding: 12px;
            border: 1px solid #eee;
            text-align: center;
            font-size: 14px;
        }

        .subject-name {
            text-align: left;
            font-weight: bold;
        }

        .summary-box {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 20px;
            margin-top: 40px;
            border-top: 2px solid #eee;
            padding-top: 20px;
        }

        .stat-item {
            text-align: center;
        }

        .stat-label {
            font-size: 12px;
            color: #888;
            text-transform: uppercase;
            font-weight: bold;
        }

        .stat-value {
            font-size: 24px;
            font-weight: bold;
            color: #4F46E5;
        }

        .footer {
            margin-top: 100px;
            display: flex;
            justify-content: space-between;
        }

        .signature {
            text-align: center;
            width: 150px;
            border-top: 1px solid #333;
            padding-top: 5px;
            font-size: 12px;
            font-weight: bold;
        }
    </style>
</head>

<body>
    <div class="report-card">
        <div class="watermark">
            <%= institution_name %>
        </div>

        <div class="header">
            <div class="school-name">
                <%= institution_name %>
            </div>
            <div class="title">Progress Report Card</div>
            <p>
                <%= academic_year %>
            </p>
        </div>

        <div class="student-info">
            <div class="info-item">
                <span class="info-label">Student Name:</span>
                <span class="info-value">
                    <%= student_name %>
                </span>
            </div>
            <div class="info-item">
                <span class="info-label">Roll No:</span>
                <span class="info-value">
                    <%= roll_no %>
                </span>
            </div>
            <div class="info-item">
                <span class="info-label">Class:</span>
                <span class="info-value">
                    <%= class_name %>
                </span>
            </div>
            <div class="info-item">
                <span class="info-label">Exam:</span>
                <span class="info-value">
                    <%= exam_name %>
                </span>
            </div>
        </div>

        <table>
            <thead>
                <tr>
                    <th class="subject-name">Subject</th>
                    <th>Max Marks</th>
                    <th>Min Marks</th>
                    <th>Marks Obtained</th>
                    <th>Grade</th>
                </tr>
            </thead>
            <tbody>
                <% subjects.forEach(function(s) { %>
                    <tr>
                        <td class="subject-name text-left">
                            <%= s.name %>
                        </td>
                        <td>
                            <%= s.max_marks %>
                        </td>
                        <td>
                            <%= s.min_marks %>
                        </td>
                        <td style="font-weight: bold;">
                            <%= s.obtained_marks %>
                        </td>
                        <td style="font-weight: bold; color: <%= s.grade === 'F' ? '#EF4444' : '#10B981' %>">
                            <%= s.grade %>
                        </td>
                    </tr>
                    <% }); %>
            </tbody>
        </table>

        <div class="summary-box">
            <div class="stat-item">
                <div class="stat-label">Total Gained</div>
                <div class="stat-value">
                    <%= total_obtained %> / <%= total_max %>
                </div>
            </div>
            <div class="stat-item">
                <div class="stat-label">Percentage</div>
                <div class="stat-value">
                    <%= percentage %>%
                </div>
            </div>
            <div class="stat-item">
                <div class="stat-label">Final Result</div>
                <div class="stat-value" style="color: <%= result === 'PASS' ? '#10B981' : '#EF4444' %>">
                    <%= result %>
                </div>
            </div>
        </div>

        <div class="footer">
            <div class="signature">Class Teacher</div>
            <div class="signature">Principal</div>
        </div>
    </div>
</body>

</html>